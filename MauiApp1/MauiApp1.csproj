<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFrameworks >net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks> -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
		<!--<RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64;win10-x64</RuntimeIdentifiers> -->

		<UseRidGraph>true</UseRidGraph>

		<OutputType>Exe</OutputType>
		<RootNamespace>RoastPath.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>RoastPath</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.millcityroasters.roastpath.client</ApplicationId>
		<ApplicationIdGuid>8abdc0c8-ee36-44db-b2e7-32f7e00ef7b8</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.0.1620.2525</ApplicationDisplayVersion>
		<ApplicationVersion>400</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>60EC5A668EF5B00DE5A073ACF33ECED50DCC852F</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationTitle>RoastPath</ApplicationTitle>
	  	<CreatePackage>false</CreatePackage>
		<CodesignKey>Apple Development: Scott Davis (73BCH2VZY4)</CodesignKey>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-maccatalyst|AnyCPU'">
	  <ApplicationTitle>RoastPath</ApplicationTitle>
		<CodesignKey>Developer ID Application: Mill City Roasters, LLC (DLJLZEVP69)</CodesignKey>
		<CodesignProvision>RPScottMacCatalystDeveloperIdDistribution08082024a</CodesignProvision>
		<CreatePackage>false</CreatePackage>
		<MtouchHttpClientHandler>NSUrlSessionHandler</MtouchHttpClientHandler>
		<UseHardenedRuntime>true</UseHardenedRuntime>

		<EnableMacCatalystUniversalBuild>true</EnableMacCatalystUniversalBuild>
		<PublishAot>true</PublishAot>
  		<MtouchLink>Full</MtouchLink>
  		<AotAssemblies>true</AotAssemblies>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<NativeReference Include="Platforms/MacCatalyst/Frameworks/Phidget22.framework">
			<Kind>Framework</Kind>
			<SmartLink>false</SmartLink>
		</NativeReference>
	</ItemGroup>


	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!--  https://github.com/xamarin/xamarin-macios/issues/19451  -->
<!--	<PropertyGroup>
    	<_UseClassicLinker>false</_UseClassicLinker>
	</PropertyGroup>
-->

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
		<PackageReference Include="Phidget22.NET" Version="1.20.20240911" />
	</ItemGroup>

	<Target Name="PostBuildSymlink" AfterTargets="Build">
		<PropertyGroup>
			<AppBundlePath>$(OutputPath)$(AssemblyName).app</AppBundlePath>
		</PropertyGroup>
		<!--This events runs mutiple times. If create bundle property is false, one of the times this fires will result in a location without an app file. Use the Exists condition to check location. -->
		<Message Text="AppBundlePath is: $(AppBundlePath)" Importance="High" Condition="Exists('$(AppBundlePath)')"/>
    	<Exec Command="ln -sf ../Frameworks/Phidget22.framework/Versions/A/Phidget22 $(AppBundlePath)/Contents/MonoBundle/libphidget22.dylib" Condition="Exists('$(AppBundlePath)')"/>
		<!--Remove the the Windows Phidget Libraries, the dll folder-->
    	<Exec Command="rm -rf $(AppBundlePath)/Contents/MonoBundle/dll" Condition="Exists('$(AppBundlePath)')"/> 
	</Target>
</Project>
